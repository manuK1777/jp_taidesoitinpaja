---
import { Image } from 'astro:assets';
import instagramIcon from '../assets/instagram-wood-icon.png';
import facebookIcon from '../assets/facebook-wood-icon.png';

interface Props {
  size?: number;
  class?: string;
}

const { size = 40, class: className } = Astro.props;

const links = [
  { label: 'Instagram', href: 'https://www.instagram.com/taidesoitinpaja/', icon: instagramIcon },
  { label: 'Facebook', href: 'https://www.facebook.com/taidesoitinpaja', icon: facebookIcon },
];
---

<ul class:list={['social-links', className]} style={`--social-size: ${size}px`}>
  {links.map((link) => (
    <li>
      <a
        href={link.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Taidesoitinpaja on ${link.label} (opens in a new tab)`}
      >
        <Image src={link.icon} alt="" width={size * 2} height={size * 2} />
      </a>
    </li>
  ))}
</ul>

<style>
  .social-links {
    display: flex;
    gap: 12px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .social-links a {
    display: block;
    transition: transform 0.2s ease, filter 0.2s ease;
  }
  .social-links a:hover,
  .social-links a:focus-visible {
    transform: translateY(-2px);
    filter: brightness(1.1);
  }
  .social-links img {
    display: block;
    width: var(--social-size);
    height: var(--social-size);
  }
</style>
