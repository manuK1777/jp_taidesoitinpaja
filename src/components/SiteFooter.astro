---
import { Image } from 'astro:assets';
import logoMoose from '../assets/logo-icon-moose.webp';

const navItems = [
  { label: 'Home', href: '/' },
  { label: 'Instruments', href: '/instruments' },
  { label: 'Repair & Maintenance', href: '/repair-maintenance' },
  { label: 'Workshops & Events', href: '/workshops-events' },
  { label: 'Our Story', href: '/our-story' },
  { label: 'Contact', href: '/contact' },
];

const currentPath = new URL(Astro.request.url).pathname;
const isCurrent = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div>
      <div class="site-footer__brand">
        <Image src={logoMoose} alt="Taidesoitinpaja" width={200} class="site-footer__logo" />
      </div>
      <p class="site-brand__text">Handcrafted folk instruments from Finland</p>
    </div>
    <nav aria-labelledby="footer-explore-heading">
      <h2 class="site-footer__heading" id="footer-explore-heading">Explore</h2>
      <div class="site-footer__links">
        {navItems.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))}
      </div>
    </nav>
    <div>
      <h2 class="site-footer__heading">Contact</h2>
      <p class="site-footer__contact">
        Taidesoitinpaja<br />
        J-P Lilja<br />
        Lahdenperä 142, 09120 Karjalohja, Finland<br /><br />
        +358 40 575 5403<br />
        taidesoitinpaja@gmail.com
      </p>
    </div>
  </div>
  <div class="container site-footer__bottom">
    <span>© {new Date().getFullYear()} Taidesoitinpaja. All rights reserved.</span>
    <div class="dev-brand">
      Site by <a href="https://mkrapo.dev/" target="_blank" rel="noopener noreferrer" class="dev-link"><span class="dev-k">K</span><span class="dev-m">M</span></a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background:
      linear-gradient(rgb(36 27 20 / 12%), rgb(36 27 20 / 12%)),
      url('/images/wood-mahogany.webp') center / cover;
    backdrop-filter: blur(6px);
    color: oklch(92% 0.015 80);
    padding: var(--space-5) 0 var(--space-2);
  }
  .site-footer__inner {
    display: grid;
    gap: var(--space-3);
  }
  @media (min-width: 700px) {
    .site-footer__inner {
      grid-template-columns: 1.3fr 1fr 1fr;
    }
  }
  .site-footer__brand {
    margin-bottom: 10px;
  }
  .site-brand__text {
    font-size: 0.975rem;
  }
  .site-footer__logo {
    height: auto;
    display: block;
  }
  .site-footer p {
    color: oklch(80% 0.015 80);
  }
  .site-footer__heading {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-brass);
    margin-bottom: var(--space-1);
  }
  .site-footer__links {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .site-footer__links a {
    font-size: 0.875rem;
    color: oklch(88% 0.015 80);
    text-decoration: none;
  }
  .site-footer__links a:hover {
    color: var(--color-brass);
  }
  .site-footer__contact {
    font-size: 0.875rem;
    line-height: 1.8;
    color: oklch(88% 0.015 80);
  }
  .site-footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
    padding-top: var(--space-2);
    border-top: 1px solid oklch(40% 0.02 60);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.03em;
    color: oklch(65% 0.015 75);
  }
  .dev-brand {
    font-size: 0.85rem;
    font-family: var(--font-display);
    letter-spacing: 0.05em;
  }
  .dev-link {
    color: var(--color-brass);
    text-decoration: none;
    font-weight: 600;
  }
  .dev-link:hover {
    color: #dc2626;
  }
  .dev-k {
  display: inline-block;
  transform: rotateY(180deg) translateY(0.3rem);
  font-size: 0.95rem;
}
.dev-m {
  vertical-align: middle;
  font-size: 0.95rem;
}
</style>
