---
import WoodArrowButton from './WoodArrowButton.astro';
import WoodenCloseButton from './WoodenCloseButton.astro';

// Reusable lightbox. Include this component ONCE per page.
// Any element on the page can trigger it by adding:
//   data-lightbox-group="[gallery id]"      (groups images into one carousel)
//   data-lightbox-src="[full-size image URL]"
//   data-lightbox-alt="[description]"
//   data-lightbox-caption="[optional caption]"
// Clicking any element with data-lightbox-group opens the dialog showing
// every image sharing that same group value, starting at the clicked one.
---

<dialog id="lightbox" class="lightbox">
  <figure class="lightbox__figure">
    <div class="lightbox__media">
      <WoodenCloseButton
        ariaLabel="Close"
        gradientId="lightbox-wood-gradient-close"
        className="lightbox__close"
      />
      <div class="lightbox__nav lightbox__nav--prev">
        <WoodArrowButton
          direction="left"
          ariaLabel="Previous image"
          gradientId="lightbox-wood-gradient-left"
        />
      </div>
      <img class="lightbox__image" src="" alt="" />
      <p class="lightbox__hint" aria-hidden="true"><span class="lightbox__hint-arrow">‹</span> Swipe for more <span class="lightbox__hint-arrow">›</span></p>
      <div class="lightbox__nav lightbox__nav--next">
        <WoodArrowButton
          direction="right"
          ariaLabel="Next image"
          gradientId="lightbox-wood-gradient-right"
        />
      </div>
    </div>
    <figcaption class="lightbox__caption"></figcaption>
  </figure>
  <div class="lightbox__dots" hidden></div>
  <p class="lightbox__counter" hidden></p>
</dialog>

<script>
  type LightboxItem = { src: string; alt: string; caption: string };

  const dialog = document.getElementById('lightbox') as HTMLDialogElement;
  const imageEl = dialog.querySelector('.lightbox__image') as HTMLImageElement;
  const captionEl = dialog.querySelector('.lightbox__caption') as HTMLElement;
  const dotsEl = dialog.querySelector('.lightbox__dots') as HTMLElement;
  const counterEl = dialog.querySelector('.lightbox__counter') as HTMLElement;
  const closeBtn = dialog.querySelector('.lightbox__close') as HTMLButtonElement;
  const prevBtn = dialog.querySelector('.lightbox__nav--prev') as HTMLElement;
  const nextBtn = dialog.querySelector('.lightbox__nav--next') as HTMLElement;
  const mediaEl = dialog.querySelector('.lightbox__media') as HTMLElement;
  const hintEl = dialog.querySelector('.lightbox__hint') as HTMLElement;

  const STORAGE_KEY = 'lightbox-hint-dismissed';
  const isTouchDevice = window.matchMedia('(hover: none) and (pointer: coarse)').matches;

  let currentItems: LightboxItem[] = [];
  let currentIndex = 0;

  function render() {
    const item = currentItems[currentIndex];
    if (imageEl.src !== item.src) {
      dialog.classList.add('is-loading');
      imageEl.src = item.src;
    }
    imageEl.alt = item.alt;
    captionEl.textContent = item.caption;
    dotsEl.querySelectorAll<HTMLElement>('.lightbox__dot').forEach((dot, i) => {
      dot.setAttribute('aria-pressed', i === currentIndex ? 'true' : 'false');
    });
    counterEl.textContent = `${currentIndex + 1} / ${currentItems.length}`;
  }

  imageEl.addEventListener('load', () => dialog.classList.remove('is-loading'));
  imageEl.addEventListener('error', () => dialog.classList.remove('is-loading'));

  function open(groupItems: LightboxItem[], startIndex: number) {
    currentItems = groupItems;
    currentIndex = startIndex;

    const useDots = groupItems.length <= 12;
    dotsEl.hidden = !useDots;
    counterEl.hidden = useDots;

    dotsEl.innerHTML = '';
    if (useDots) {
      groupItems.forEach((_, i) => {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'lightbox__dot';
        dot.setAttribute('aria-label', `Go to image ${i + 1}`);
        dot.addEventListener('click', () => goTo(i));
        dotsEl.appendChild(dot);
      });
    }

    render();
    dialog.showModal();

    const dismissed = (() => {
      try {
        return localStorage.getItem(STORAGE_KEY);
      } catch {
        return '1';
      }
    })();

    if (isTouchDevice && groupItems.length > 1 && !dismissed) {
      hintEl.classList.add('is-visible');
    }
  }

  function dismissHint() {
    if (!hintEl.classList.contains('is-visible')) return;
    hintEl.classList.remove('is-visible');
    try {
      localStorage.setItem(STORAGE_KEY, '1');
    } catch {}
  }

  function next() {
    currentIndex = (currentIndex + 1) % currentItems.length;
    render();
  }

  function prev() {
    currentIndex = (currentIndex - 1 + currentItems.length) % currentItems.length;
    render();
  }

  function goTo(index: number) {
    currentIndex = (index + currentItems.length) % currentItems.length;
    render();
  }

  closeBtn.addEventListener('click', () => dialog.close());
  nextBtn.addEventListener('click', next);
  prevBtn.addEventListener('click', prev);

  // Click on the backdrop (outside the image/controls) closes it
  dialog.addEventListener('click', (e) => {
    dismissHint();
    if (e.target === dialog) dialog.close();
  });

  dialog.addEventListener('keydown', (e) => {
    dismissHint();
    if (e.key === 'ArrowRight') next();
    if (e.key === 'ArrowLeft') prev();
    // Escape-to-close is native <dialog> behavior, no extra code needed
  });

  let touchStartX = 0;
  let touchStartY = 0;

  mediaEl.addEventListener('touchstart', (e) => {
    const touch = e.touches[0];
    touchStartX = touch.clientX;
    touchStartY = touch.clientY;
  }, { passive: true });

  mediaEl.addEventListener('touchend', (e) => {
    dismissHint();
    const touch = e.changedTouches[0];
    const deltaX = touch.clientX - touchStartX;
    const deltaY = touch.clientY - touchStartY;

    if (Math.abs(deltaX) > 40 && Math.abs(deltaX) > Math.abs(deltaY)) {
      if (deltaX < 0) next();
      else prev();
    }
  }, { passive: true });

  // Wire up every trigger element present on the page, grouped by
  // data-lightbox-group. Runs once on load — if you add gallery items
  // dynamically after this, re-run this same setup logic.
  function initTriggers() {
    const triggers = Array.from(
      document.querySelectorAll<HTMLElement>('[data-lightbox-group]')
    );

    const groups = new Map<string, LightboxItem[]>();
    triggers.forEach((el) => {
      const group = el.dataset.lightboxGroup!;
      const src = el.dataset.lightboxSrc || '';
      const alt = el.dataset.lightboxAlt || '';
      const caption = el.dataset.lightboxCaption || '';
      if (!groups.has(group)) groups.set(group, []);
      groups.get(group)!.push({ src, alt, caption });
    });

    // Track each trigger's index within its own group
    const indexWithinGroup = new Map<string, number>();
    triggers.forEach((el) => {
      const group = el.dataset.lightboxGroup!;
      const idx = indexWithinGroup.get(group) ?? 0;
      indexWithinGroup.set(group, idx + 1);

      const handler = () => {
        open(groups.get(group)!, idx);
      };
      el.addEventListener('click', handler);

      // Buttons/links are already focusable and keyboard-activatable;
      // only shim in a11y semantics for plain wrapper elements (e.g. a div).
      if (el.tagName !== 'BUTTON' && el.tagName !== 'A') {
        el.style.cursor = 'pointer';
        el.setAttribute('role', 'button');
        el.setAttribute('tabindex', '0');
        el.addEventListener('keydown', (e: KeyboardEvent) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            handler();
          }
        });
      }
    });
  }

  initTriggers();
</script>

<style>
  .lightbox {
    border: none;
    background: transparent;
    padding: 0;
    max-width: 100vw;
    max-height: 100vh;
    width: 100%;
    height: 100%;
  }

  .lightbox::backdrop {
    background:var(--color-green);
  }

  .lightbox[open] {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    align-items: center;
    justify-content: center;
  }

  .lightbox__figure {
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    margin: 0;
  }

  .lightbox__image {
    max-width: calc(90vw - (2 * var(--lightbox-frame-width)));
    max-height: calc(80vh - (2 * var(--lightbox-frame-width)));
    object-fit: contain;
    display: block;
    opacity: 1;
    transition: opacity 150ms ease;
  }

  .lightbox.is-loading .lightbox__image {
    opacity: 0;
  }

  .lightbox__caption {
    color: var(--color-brass);
    text-align: center;
  }

  .lightbox__caption:empty {
    display: none;
  }

  .lightbox__media {
    --lightbox-frame-width: 12px;
    position: relative;
    border: var(--lightbox-frame-width) solid transparent;
    border-radius: var(--radius);
    border: 8px solid #6b4c2e;
    outline: 1px solid #4a2f1c;
    overflow: hidden;
    box-shadow:
      inset 0 1px rgb(255 245 220 / 32%),
      inset 0 -2px rgb(55 33 18 / 35%),
      0 4px 12px rgb(0 0 0 / 28%);
  }

  .lightbox__media::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(ellipse at center, transparent 35%, rgb(12 9 6 / 55%) 100%);
  }

  :global(.lightbox__close) {
    position: absolute;
    z-index: 3;
    top: var(--space-1);
    right: var(--space-1);
  }

  .lightbox__nav {
    position: absolute;
    top: 50%;
    z-index: 2;
    transform: translateY(-50%);
  }

  .lightbox__nav :global(.wood-arrow-btn) {
    display: block;
  }

  .lightbox__nav--prev {
    left: var(--space-1);
  }

  .lightbox__nav--next {
    right: var(--space-1);
  }

  .lightbox__hint {
    position: absolute;
    bottom: var(--space-2);
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    margin: 0;
    padding: 0.4rem 1rem;
    border-radius: 999px;
    background: rgba(12, 9, 6, 0.72);
    color: rgb(255 245 220);
    font-size: 0.8rem;
    line-height: 1;
    pointer-events: none;
    opacity: 0;
    transition: opacity 250ms ease;
  }

  .lightbox__hint-arrow {
    font-size: 2em;
    vertical-align: middle;
    margin-inline: 0.10em;
  }

  @media (hover: none) and (pointer: coarse) {
    .lightbox__nav {
      display: none;
    }

    .lightbox__hint.is-visible {
      opacity: 1;
    }
  }

  .lightbox__dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-1);
    margin: 0;
  }

  :global(.lightbox__dot) {
    width: 10px;
    height: 10px;
    min-width: 10px;
    min-height: 10px;
    flex: 0 0 auto;
    border: 0;
    border-radius: 50%;
    padding: 0;
    background: var(--color-brass);
    opacity: 0.35;
    cursor: pointer;
    transition: opacity 180ms ease;
    -webkit-appearance: none;
    appearance: none;
  }

  :global(.lightbox__dot[aria-pressed="true"]) {
    opacity: 1;
  }

  .lightbox__counter {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    color: var(--color-brass);
    margin: 0;
    text-align: center;
  }

</style>
