---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Our Story">
  <main class="container page">
    <h1>Our Story</h1>
    <p>Taidesoitinpaja's journey is rooted in a deep passion for preserving the rich essence of folk music through exquisitely handcrafted instruments.</p>
  </main>
</Layout>

<style>
  .page {
    padding-block: var(--space-5);
  }
  .page h1 {
    color: var(--color-brass);
    margin-bottom: var(--space-2);
  }
  .page p {
    font-size: 1.0625rem;
    line-height: 1.75;
    max-width: 38rem;
  }
</style>
