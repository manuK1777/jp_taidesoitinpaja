---
import Layout from '../layouts/Layout.astro';
import InstrumentsBrowser from '../components/InstrumentsBrowser.astro';
import { sanityClient } from '../lib/sanity';

const instruments = await sanityClient.fetch(`
  *[_type == "instrument"] | order(order asc) {
    name,
    "slug": slug.current,
    price,
    "categoryTitle": instrumentType->title,
    "image": images[0]
  }
`);

const categoryTitles: string[] = instruments
  .map((inst: any) => inst.categoryTitle as string)
  .filter((title: string) => !!title);

const instrumentTypes = [...new Set(categoryTitles)].map((title) => ({ title }));
---

<Layout title="Instruments">
  <section class="instruments-band reveal" aria-labelledby="instruments-heading">
    <div class="container">
      <div class="instruments-band__header">
        <div>
          <p class="eyebrow" id="instruments-eyebrow">Collection</p>
          <h2 id="instruments-heading">Folk Instruments for Sale</h2>
        </div>
      </div>
      <InstrumentsBrowser instruments={instruments} types={instrumentTypes} />
    </div>
  </section>
</Layout>

<style>
  .instruments-band {
    background:
      linear-gradient(rgb(36 27 20 / 12%), rgb(36 27 20 / 62%)),
      url('/images/striped-wood-texture.webp') center / cover;
    padding-block: var(--space-5);
  }
  .instruments-band__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-bottom: var(--space-3);
  }

  /* @media (min-width: 900px) {
    .instruments-band {
      background:
        linear-gradient(rgb(36 27 20 / 12%), rgb(36 27 20 / 62%)),
        url('/images/striped-wood-texture.webp') center / cover;
      padding-block: var(--space-5);
    }
  } */
  @media (max-width: 899px) {
    .instruments-band {
      background-position: right 60% center;
    }
  }
</style>
