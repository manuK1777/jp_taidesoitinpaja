---
import Layout from '../layouts/Layout.astro';
import InstrumentsBrowser from '../components/InstrumentsBrowser.astro';
import { sanityClient } from '../lib/sanity';

const instruments = await sanityClient.fetch(`
  *[_type == "instrument"] | order(order asc) {
    name,
    "slug": slug.current,
    price,
    "categoryTitle": instrumentType->title,
    shortDescription,
    badge,
    "images": images[0...2]
  }
`);

const categoryTitles: string[] = instruments
  .map((inst: any) => inst.categoryTitle as string)
  .filter((title: string) => !!title);

const instrumentTypes = [...new Set(categoryTitles)].map((title) => ({ title }));
---

<Layout
  title="Instruments"
  description="Browse handcrafted igils, doshpuluurs, jouhikkos and air-tunable frame drums for sale from Taidesoitinpaja in Finland."
>
  <section class="instruments-band wood-band reveal" aria-labelledby="instruments-heading">
    <div class="container">
      <div class="instruments-band__header">
        <div>
          <p class="eyebrow" id="instruments-eyebrow">Collection</p>
          <h1 id="instruments-heading">Folk Instruments for Sale</h1>
        </div>
      </div>
      <InstrumentsBrowser instruments={instruments} types={instrumentTypes} />
    </div>
  </section>
</Layout>

<style>

  h1 {
    font-size: clamp(2.25rem, 6vw, 3.5rem);
    text-shadow:
      -1px -1px 1px oklch(20% 0.02 63 / 0.18),   
      1px  1px 1px oklch(60% 0.03 63 / 0.7);
  }

  .instruments-band {
    --wood-band-overlay: linear-gradient(oklch(96% .05 85.26 / .55), oklch(90% .04 80 / .35)),
      linear-gradient(#241b140a, #241b142e);
    padding-block: var(--space-4) var(--space-5);
    box-shadow: inset 0 5px 12px #321c0a38, inset 0 -5px 12px #321c0a38;
  }

  .instruments-band__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-bottom: var(--space-3);
  }

  @media (max-width: 899px) {
    .instruments-band {
      padding-block: var(--space-4);
    }
  }
</style>
