---
import Layout from '../layouts/Layout.astro';
import InstrumentCard from '../components/InstrumentCard.astro';
import { sanityClient } from '../lib/sanity';

const instruments = await sanityClient.fetch(`
  *[_type == "instrument"] | order(order asc) {
    name,
    "slug": slug.current,
    price,
    "categoryTitle": instrumentType->title,
    "image": images[0]
  }
`);
---

<Layout title="Instruments">
  <section class="instruments-band reveal" aria-labelledby="instruments-heading">
    <div class="container">
      <div class="instruments-band__header">
        <div>
          <p class="eyebrow" id="instruments-eyebrow">Collection</p>
          <h2 id="instruments-heading">Folk Instruments for Sale</h2>
        </div>
      </div>
      <div class="instruments-band__grid">
        {instruments.map((inst: any) => (
          <InstrumentCard
            name={inst.name}
            slug={inst.slug}
            price={inst.price}
            categoryTitle={inst.categoryTitle}
            image={inst.image}
          />
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .instruments-band {
    background:
      linear-gradient(rgb(36 27 20 / 12%), rgb(36 27 20 / 62%)),
      url('/images/striped-wood-texture.webp') center / cover;
    padding-block: var(--space-5);
  }
  .instruments-band__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-bottom: var(--space-3);
  }
  .instruments-band__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }
  @media (min-width: 700px) {
    .instruments-band__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
