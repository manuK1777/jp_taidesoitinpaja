---
import Layout from '../layouts/Layout.astro';
import WorkshopEventCard from '../components/WorkshopEventCard.astro';
import { sanityClient } from '../lib/sanity';
import { sortEvents } from '../lib/workshopEvents';

const workshopEvents = await sanityClient.fetch(`
  *[_type == "workshopEvent" && defined(slug.current)] {
    title,
    "slug": slug.current,
    type,
    coverImage,
    shortDescription,
    startDateTime,
    endDateTime,
    location,
    price,
    order
  }
`);

const sortedEvents = sortEvents<any>(workshopEvents);
---

<Layout title="Workshops & Events">
  <section class="workshops-band wood-band reveal" aria-labelledby="workshops-heading">
    <div class="container">
      <div class="workshops-band__header">
        <p class="eyebrow">Join our courses & events</p>
        <h1 id="workshops-heading">Workshops &amp; Events</h1>
      </div>
      {sortedEvents.length > 0 ? (
        <div class="workshops-band__grid">
          {sortedEvents.map((event: any) => (
            <WorkshopEventCard
              title={event.title}
              slug={event.slug}
              type={event.type}
              coverImage={event.coverImage}
              shortDescription={event.shortDescription}
              startDateTime={event.startDateTime}
              endDateTime={event.endDateTime}
              location={event.location}
              price={event.price}
            />
          ))}
        </div>
      ) : (
        <p>No workshops or events are scheduled at the moment.</p>
      )}
    </div>
  </section>
</Layout>

<style>
  h1 {
    font-size: clamp(2.25rem, 6vw, 3.5rem);
    text-shadow:
      -1px -1px 1px oklch(20% 0.02 63 / 0.18),
      1px  1px 1px oklch(60% 0.03 63 / 0.7);
  }

  .workshops-band {
    --wood-band-overlay: linear-gradient(oklch(96% .05 85.26 / .55), oklch(90% .04 80 / .35)),
      linear-gradient(#241b140a, #241b142e);
    padding-block: var(--space-4) var(--space-5);
    box-shadow: inset 0 5px 12px #321c0a38, inset 0 -5px 12px #321c0a38;
  }

  .workshops-band__header {
    margin-bottom: var(--space-3);
  }

  .workshops-band__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
  }

  @media (min-width: 640px) {
    .workshops-band__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1000px) {
    .workshops-band__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 899px) {
    .workshops-band {
      padding-block: var(--space-4);
    }
  }
</style>
