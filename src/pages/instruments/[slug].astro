---
import Layout from '../../layouts/Layout.astro';
import WoodArrowButton from '../../components/WoodArrowButton.astro';
import WoodenScrollBar from '../../components/WoodenScrollBar.astro';
import Lightbox from '../../components/Lightbox.astro';
import { PortableText } from 'astro-portabletext';
import { sanityClient, urlFor } from '../../lib/sanity';

export async function getStaticPaths() {
  const slugs = await sanityClient.fetch(`
    *[_type == "instrument" && defined(slug.current)] {
      "slug": slug.current
    }
  `);

  return slugs.map((s: { slug: string }) => ({
    params: { slug: s.slug },
  }));
}

const { slug } = Astro.params;

const instrument = await sanityClient.fetch(
  `
    *[_type == "instrument" && slug.current == $slug][0] {
      name,
      price,
      availability,
      images,
      videos[]{
        "url": video.asset->url,
        "mimeType": video.asset->mimeType,
        poster,
        description
      },
      description,
      specifications,
      "categoryTitle": instrumentType->title,
      "categoryDescription": instrumentType->description
    }
  `,
  { slug }
);

if (!instrument) {
  return Astro.redirect('/404');
}

const {
  name,
  price,
  availability,
  images = [],
  videos = [],
  description,
  specifications = [],
  categoryTitle,
  categoryDescription,
} = instrument;

type GalleryItem = {
  type: 'image' | 'video';
  alt: string;
  thumbSrc?: string;
  mainSrc: string;
  mimeType?: string;
  posterSrc?: string;
};

const gallery: GalleryItem[] = [
  ...images.map((image: any, index: number) => ({
    type: 'image' as const,
    alt: `${name} – photo ${index + 1}`,
    thumbSrc: urlFor(image).width(160).height(160).fit('crop').auto('format').url(),
    mainSrc: urlFor(image).width(900).auto('format').url(),
  })),
  ...videos.map((video: any, index: number) => ({
    type: 'video' as const,
    alt: video.description || `${name} – video ${index + 1}`,
    mainSrc: video.url,
    mimeType: video.mimeType,
    thumbSrc: video.poster
      ? urlFor(video.poster).width(160).height(160).fit('crop').auto('format').url()
      : undefined,
    posterSrc: video.poster
      ? urlFor(video.poster).width(900).auto('format').url()
      : undefined,
  })),
];

const availabilityLabels: Record<string, string> = {
  'in-stock': 'In stock',
  sold: 'Sold',
  'made-to-order': 'Made to order',
};
---

<Layout title={name}>
  <section class="instrument-detail container">
    <div class="instrument-detail__gallery" data-instrument-gallery data-has-multiple={gallery.length > 1 ? 'true' : 'false'}>
      <div class="instrument-detail__main-viewer">
        {gallery.length > 1 && (
          <WoodArrowButton
            direction="left"
            ariaLabel="Previous photo"
            gradientId="instrument-gallery-wood-gradient-left"
            scrollDirection="left"
          />
        )}
        <div class="instrument-detail__main-image">
          <img
            data-gallery-main-image
            src={gallery[0]?.type === 'image' ? gallery[0]?.mainSrc : undefined}
            alt={gallery[0]?.type === 'image' ? gallery[0]?.alt : ''}
            aria-label={gallery[0]?.type === 'image' ? `Open ${gallery[0]?.alt} in lightbox` : ''}
            tabindex="0"
            role="button"
            hidden={gallery[0]?.type !== 'image'}
            loading="eager"
            decoding="async"
          />
          <video
            data-gallery-main-video
            hidden={gallery[0]?.type !== 'video'}
            src={gallery[0]?.type === 'video' ? gallery[0]?.mainSrc : undefined}
            poster={gallery[0]?.type === 'video' ? gallery[0]?.posterSrc : undefined}
            controls
            playsinline
            preload="none"
          />
        </div>
        {gallery.length > 1 && (
          <WoodArrowButton
            direction="right"
            ariaLabel="Next photo"
            gradientId="instrument-gallery-wood-gradient-right"
            scrollDirection="right"
          />
        )}
      </div>

      {gallery.length > 1 && (
        <div class="instrument-detail__carousel">
          <div class="instrument-detail__thumbs" id="instrument-thumbs-track">
            {gallery.map((item: GalleryItem, index: number) => (
              <button
                type="button"
                class="instrument-detail__thumb"
                data-gallery-thumb
                data-media-type={item.type}
                data-main-src={item.mainSrc}
                data-poster-src={item.posterSrc}
                data-alt={item.alt}
                aria-pressed={index === 0 ? 'true' : 'false'}
                aria-label={item.type === 'video' ? item.alt : `Show photo ${index + 1}`}
              >
                {item.type === 'video' ? (
                  <span class="instrument-detail__thumb-video">
                    <img src={item.thumbSrc} alt="" width="160" height="160" loading="lazy" decoding="async" />
                    <span class="instrument-detail__thumb-play" aria-hidden="true"></span>
                  </span>
                ) : (
                  <img src={item.thumbSrc} alt="" width="160" height="160" loading="lazy" decoding="async" />
                )}
              </button>
            ))}
          </div>
          {gallery.length > 6 && (
            <WoodenScrollBar for="#instrument-thumbs-track" showText={false} />
          )}
        </div>
      )}

      {gallery.length > 1 && (
        <div class="instrument-detail__mobile-carousel" data-mobile-carousel>
          {gallery.map((item: GalleryItem, index: number) => (
            <div class={'instrument-detail__mobile-slide ' + (index === 0 ? 'is-active' : '')} data-main-src={item.type === 'image' ? item.mainSrc : undefined} style={'--mobile-backdrop: ' + (item.type === 'video' && item.posterSrc ? 'url(\'' + item.posterSrc + '\')' : 'none')}>
              {item.type === 'video' ? (
                <video
                  src={item.mainSrc}
                  poster={item.posterSrc}
                  controls
                  playsinline
                  preload="none"
                />
              ) : (
                <img
                  src={item.mainSrc}
                  alt={item.alt}
                  loading={index === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              )}
            </div>
          ))}
        </div>
      )}

      {gallery.length > 1 && (
        <div class="instrument-detail__dots" data-mobile-dots>
          {gallery.map((_, index: number) => (
            <button
              type="button"
              class="instrument-detail__dot"
              data-dot-index={index}
              aria-pressed={index === 0 ? 'true' : 'false'}
              aria-label={`Go to slide ${index + 1}`}
            />
          ))}
        </div>
      )}
    </div>

    <div class="instrument-detail__info">
      <h1>{name}</h1>

      <p class="instrument-detail__price">
        {price ? `€${price}` : 'Contact for price'}
      </p>

      {availability && (
        <span class={`instrument-detail__availability instrument-detail__availability--${availability}`}>
          {availabilityLabels[availability] ?? availability}
        </span>
      )}

      {categoryDescription && (
        <div class="instrument-detail__text">
          <PortableText value={categoryDescription} />
        </div>
      )}

      {description && description.length > 0 && (
        <div class="instrument-detail__text instrument-detail__text--own">
          <PortableText value={description} />
        </div>
      )}

      {specifications.length > 0 && (
        <dl class="instrument-detail__specs">
          <h2 class="instrument-detail__specs-heading">Specifications</h2>
          {specifications.map((spec: { label?: string; value?: string }) => (
            <div class="instrument-detail__spec-row">
              <dt>{spec.label}</dt>
              <dd>{spec.value}</dd>
            </div>
          ))}
        </dl>
      )}
    </div>
  </section>

  <div aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden;">
    {gallery
      .filter((item: GalleryItem) => item.type === 'image')
      .map((item: GalleryItem) => (
        <button
          type="button"
          tabindex="-1"
          data-lightbox-group="instrument-detail"
          data-lightbox-src={item.mainSrc}
          data-lightbox-alt={item.alt}
          data-lightbox-caption={name}
        />
      ))}
  </div>

  <Lightbox />
</Layout>

<script>
  document.querySelectorAll<HTMLElement>('[data-instrument-gallery]').forEach((gallery) => {
    const mainImage = gallery.querySelector<HTMLImageElement>('[data-gallery-main-image]');
    const mainVideo = gallery.querySelector<HTMLVideoElement>('[data-gallery-main-video]');
    const mainImageFrame = gallery.querySelector<HTMLElement>('.instrument-detail__main-image');
    const thumbs = Array.from(gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-thumb]'));
    if (!mainImage || !mainVideo || !mainImageFrame || thumbs.length === 0) return;

    let current = 0;
    const track = gallery.querySelector<HTMLElement>('#instrument-thumbs-track');

    const initialThumb = thumbs[0];
    const initialPoster = initialThumb.dataset.mediaType === 'video' ? initialThumb.dataset.posterSrc : '';
    mainImageFrame.style.setProperty('--backdrop', initialPoster ? `url('${initialPoster}')` : 'none');

    mainImage.addEventListener('click', () => {
      if (mainImage.hidden) return;
      const src = mainImage.getAttribute('src');
      if (!src) return;
      const trigger = document.querySelector<HTMLElement>(`[data-lightbox-group="instrument-detail"][data-lightbox-src="${src}"]`);
      if (trigger) trigger.click();
    });

    mainImage.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        mainImage.click();
      }
    });

    const setActive = (index: number) => {
      current = (index + thumbs.length) % thumbs.length;
      const thumb = thumbs[current];
      const mainSrc = thumb.dataset.mainSrc;
      const alt = thumb.dataset.alt ?? '';
      const isVideo = thumb.dataset.mediaType === 'video';

      if (isVideo) {
        mainVideo.pause();
        if (mainSrc && mainVideo.src !== mainSrc) mainVideo.src = mainSrc;
        const posterSrc = thumb.dataset.posterSrc;
        if (posterSrc) mainVideo.poster = posterSrc;
        mainImage.hidden = true;
        mainVideo.hidden = false;
        mainVideo.play().catch(() => {});
      } else {
        if (!mainVideo.hidden) mainVideo.pause();
        mainVideo.hidden = true;
        mainImage.hidden = false;
        if (mainSrc) mainImage.src = mainSrc;
        mainImage.alt = alt;
        mainImage.setAttribute('aria-label', `Open ${alt} in lightbox`);
      }

      thumbs.forEach((t, i) => t.setAttribute('aria-pressed', i === current ? 'true' : 'false'));

      const posterSrc = thumb.dataset.posterSrc;
      mainImageFrame.style.setProperty('--backdrop', isVideo && posterSrc ? `url('${posterSrc}')` : 'none');

      if (track) {
        thumb.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'smooth' });
      }
    };

    thumbs.forEach((thumb, i) => {
      thumb.addEventListener('click', () => setActive(i));
    });

    gallery.querySelectorAll<HTMLButtonElement>('.instrument-detail__main-viewer [data-scroll]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const dir = btn.dataset.scroll === 'left' ? -1 : 1;
        setActive(current + dir);
      });
    });

    if (thumbs.length > 1) {
      let touchStartX = 0;
      let touchStartY = 0;

      mainImageFrame.addEventListener('touchstart', (e) => {
        const touch = e.touches[0];
        touchStartX = touch.clientX;
        touchStartY = touch.clientY;
      }, { passive: true });

      mainImageFrame.addEventListener('touchend', (e) => {
        const touch = e.changedTouches[0];
        const deltaX = touch.clientX - touchStartX;
        const deltaY = touch.clientY - touchStartY;

        if (Math.abs(deltaX) > 40 && Math.abs(deltaX) > Math.abs(deltaY)) {
          setActive(current + (deltaX < 0 ? 1 : -1));
        }
      }, { passive: true });
    }
  });

</script>

<script>
  document.querySelectorAll('[data-mobile-carousel]').forEach((carousel) => {
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>('.instrument-detail__mobile-slide'));
    const dots = Array.from(
      (carousel.parentElement?.querySelector<HTMLElement>('[data-mobile-dots]'))?.querySelectorAll<HTMLButtonElement>('[data-dot-index]') ?? []
    );
    if (slides.length < 2 || dots.length === 0) return;

    const updateDots = () => {
      const activeIndex = slides.findIndex((s) => s.classList.contains('is-active'));
      if (activeIndex === -1) return;
      dots.forEach((dot, i) => {
        dot.setAttribute('aria-pressed', i === activeIndex ? 'true' : 'false');
      });
    };

    slides.forEach((slide, i) => {
      const src = slide.dataset.mainSrc;
      if (src) {
        slide.addEventListener('click', () => {
          const trigger = document.querySelector<HTMLElement>(`[data-lightbox-group="instrument-detail"][data-lightbox-src="${src}"]`);
          if (trigger) trigger.click();
        });
      }

      dots[i]?.addEventListener('click', () => {
        const target = slides[i];
        const carouselRect = carousel.getBoundingClientRect();
        const targetRect = target.getBoundingClientRect();
        const scrollLeft = carousel.scrollLeft + (targetRect.left - carouselRect.left) - (carousel.clientWidth - target.clientWidth) / 2;
        carousel.scrollTo({ left: scrollLeft, behavior: 'smooth' });
      });
    });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          entry.target.classList.toggle('is-active', entry.isIntersecting);
        });
        updateDots();
      },
      { root: carousel, threshold: 0.5 }
    );

    slides.forEach((slide) => observer.observe(slide));
    updateDots();
  });
</script>

<style>
  .instrument-detail {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-5);
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 900px) {
    .instrument-detail {
      grid-template-columns: minmax(0, 700px) 1fr;
      align-items: start;
      column-gap: 0px;
    }
  }

  .instrument-detail__main-viewer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    width: 100%;
    max-width: 100%;
  }

   @media (max-width: 639px) {
    .instrument-detail__main-viewer {
      gap: var(--space-1);
    }
    .instrument-detail__main-viewer :global(.wood-arrow-btn) {
      width: 22px;
      height: 22px;
    }
    [data-has-multiple="true"] .instrument-detail__main-viewer,
    [data-has-multiple="true"] .instrument-detail__carousel {
      display: none;
    }
  }

  .instrument-detail__mobile-carousel,
  .instrument-detail__dots {
    display: none;
  }

  @media (max-width: 639px) {
    .instrument-detail__mobile-carousel {
      display: flex;
      gap: var(--space-2);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      width: 100%;
    }

    .instrument-detail__mobile-carousel::-webkit-scrollbar {
      display: none;
    }

    .instrument-detail__mobile-slide {
      flex: 0 0 75%;
      scroll-snap-align: center;
      position: relative;
      aspect-ratio: 3 / 4;
      background: var(--color-spruce-black);
      border-radius: var(--radius);
      border: 8px solid #6b4c2e;
      box-shadow: 0 4px 12px rgb(0 0 0 / 20%);
      overflow: hidden;
      opacity: 0.7;
      transform: scale(0.96);
      transition: opacity 200ms ease, transform 200ms ease;
    }

    .instrument-detail__mobile-slide.is-active {
      opacity: 1;
      transform: scale(1);
    }

    .instrument-detail__mobile-slide::before {
      content: '';
      position: absolute;
      inset: -20px;
      background-image: var(--mobile-backdrop, none);
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      filter: blur(24px) brightness(0.75);
      transform: scale(1.08);
      z-index: 0;
    }

    .instrument-detail__mobile-slide img,
    .instrument-detail__mobile-slide video {
      position: relative;
      z-index: 1;
      width: 100%;
      height: 100%;
      object-fit: contain;
      display: block;
    }

    .instrument-detail__mobile-slide img {
      object-fit: cover;
    }

    .instrument-detail__dots {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: var(--space-1);
      margin-top: var(--space-2);
      width: 100%;
    }

    .instrument-detail__dot {
      width: 10px;
      height: 10px;
      border: 0;
      border-radius: 999px;
      padding: 0;
      background: var(--color-green);
      opacity: 0.35;
      cursor: pointer;
      transition: opacity 180ms ease;
    }

    .instrument-detail__dot[aria-pressed="true"] {
      opacity: 1;
    }
  }

  .instrument-detail__main-viewer :global(.wood-arrow-btn) {
    flex: 0 0 auto;
    width: 40px;
    height: 40px;
  }

  .instrument-detail__main-image {
    flex: 0 1 500px;
    min-width: 0;
    max-width: 500px;
    aspect-ratio: 3 / 4;
    position: relative;
    background: var(--color-spruce-black);
    border-radius: var(--radius);
    border: 12px solid #6b4c2e;
    box-shadow: 0 4px 12px rgb(0 0 0 / 20%);
    transition: transform 180ms ease, box-shadow 180ms ease;
    overflow: hidden;
  }

  @media (max-width: 639px) {
  .instrument-detail__main-image {
    border: 8px solid #6b4c2e;
  }
}

  .instrument-detail__main-image::before {
    content: '';
    position: absolute;
    inset: -20px;
    background-image: var(--backdrop, none);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    filter: blur(24px) brightness(0.75);
    transform: scale(1.08);
    z-index: 0;
  }

  .instrument-detail__main-image img,
  .instrument-detail__main-image video {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .instrument-detail__main-image img {
    object-fit: cover;
    cursor: pointer;
  }

  .instrument-detail__main-image img[hidden],
  .instrument-detail__main-image video[hidden] {
    display: none;
  }

  .instrument-detail__carousel {
    margin-top: var(--space-3);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    width: min(100%, calc(6 * 70px + 5 * var(--space-1)));
  }

  .instrument-detail__thumbs {
    display: flex;
    gap: var(--space-1);
    overflow-x: auto;
    scrollbar-width: none;
    padding-block: var(--space-1);
    width: 100%;
  }

  .instrument-detail__carousel :global(.wood-scrollbar) {
    width: 100%;
  }

  .instrument-detail__thumbs::-webkit-scrollbar {
    display: none;
  }

  @media (hover: none) and (pointer: coarse) {
    .instrument-detail__carousel :global(.wood-scrollbar) {
      display: none;
    }
  }

  .instrument-detail__thumb-video {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
  }

  .instrument-detail__thumb-video img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .instrument-detail__thumb-play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgb(0 0 0 / 35%);
    pointer-events: none;
  }

  .instrument-detail__thumb-play::after {
    content: '';
    display: block;
    width: 0;
    height: 0;
    margin-left: 3px;
    border-style: solid;
    border-width: 8px 0 8px 14px;
    border-color: transparent transparent transparent var(--color-brass);
  }

  .instrument-detail__thumb {
    flex: 0 0 auto;
    border: 0;
    border-radius: 5px;
    border: 2px solid #6b4c2e;
    box-shadow: 0 2px 6px rgb(0 0 0 / 20%);
    background: none;
    padding: 0;
    width: 70px;
    height: 70px;
    overflow: hidden;
    cursor: pointer;
    opacity: 0.75;
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .instrument-detail__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .instrument-detail__thumb:hover {
    opacity: 0.85;
     transform: scale(1.1);
    z-index: 1;
  }

  .instrument-detail__thumb[aria-pressed="true"] {
    opacity: 1;
    transform: scale(1.1);
    z-index: 1;
  }

  .instrument-detail__info h1 {
    margin-bottom: var(--space-2);
    font-size: 2rem;
  }

  .instrument-detail__specs-heading {
    margin-bottom: var(--space-1);
    font-size: 1.5rem;
    text-shadow: none;
  }

  .instrument-detail__price {
    font-family: var(--font-mono);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-cream);
  }

  .instrument-detail__availability {
    display: inline-block;
    margin-top: var(--space-1);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.35em 0.8em;
    border-radius: 999px;
    border: 1px solid var(--color-brass);
    color: var(--color-brass);
  }

  .instrument-detail__availability--sold {
    color: var(--color-oxblood);
    border-color: var(--color-oxblood);
  }

  .instrument-detail__availability--in-stock {
    color: var(--color-dark-brass);
    background: color-mix(in oklch, var(--color-brass) 12%, transparent);
  }

  .instrument-detail__text {
    margin-top: var(--space-3);
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .instrument-detail__text--own {
    margin-top: var(--space-2);
  }

  .instrument-detail__text :global(p) {
    margin-bottom: var(--space-3);
    color: var(--color-text-muted);
  }

  .instrument-detail__specs {
    margin-top: var(--space-1);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .instrument-detail__spec-row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    padding-block: 0.4rem;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.95rem;
  }

  .instrument-detail__spec-row dt {
    font-weight: 600;
    color: var(--color-cream);
  }

  .instrument-detail__spec-row dd {
    margin: 0;
    color: var(--color-text-muted);
    text-align: right;
  }
</style>
