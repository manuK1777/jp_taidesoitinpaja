---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact" description="Get in touch with Taidesoitinpaja — handcrafted folk instruments from Karjalohja, Finland.">
  <section class="contact" aria-labelledby="contact-heading">
    <div class="container">
      <h1 id="contact-heading" class="contact__title">Contact us</h1>
      <div class="contact__inner">
        <div class="contact__details reveal">
          <div class="contact__block">
            <h2 class="contact__label">Address</h2>
            <p>
              Lahdenperä 142<br />
              09120 Karjalohja<br />
              Finland
            </p>
          </div>

          <div class="contact__block">
            <h2 class="contact__label">Telephone</h2>
            <p><a href="tel:+358405755403">+358 40 575 5403</a></p>
          </div>

          <div class="contact__block">
            <h2 class="contact__label">Email</h2>
            <p><a class="contact__email" href="mailto:taidesoitinpaja@gmail.com">taidesoitinpaja@gmail.com</a></p>
          </div>

        </div>

        <div class="contact-card reveal">
          <h2 class="contact-card__title">Send a message</h2>
          <form id="contactForm" class="contact-form" action="https://api.web3forms.com/submit" method="post">
            <input type="hidden" name="access_key" value="7805c6d9-fdaf-4ebe-91e6-2e736833ea2b" />
            <div class="visually-hidden" aria-hidden="true">
              <input type="checkbox" id="botcheck" name="botcheck" tabindex="-1" autocomplete="off" />
            </div>
            <div class="contact-form__row">
              <div class="contact-form__field">
                <label for="first-name">First name <span aria-hidden="true">*</span></label>
                <input type="text" id="first-name" name="first_name" autocomplete="given-name" required />
              </div>
              <div class="contact-form__field">
                <label for="last-name">Last name <span aria-hidden="true">*</span></label>
                <input type="text" id="last-name" name="last_name" autocomplete="family-name" required />
              </div>
            </div>
            <div class="contact-form__field">
              <label for="email">Email <span aria-hidden="true">*</span></label>
              <input type="email" id="email" name="email" autocomplete="email" required />
            </div>
            <div class="contact-form__field">
              <label for="message">Write a message <span aria-hidden="true">*</span></label>
              <textarea id="message" name="message" rows="5" required></textarea>
            </div>
            <button type="submit" class="btn btn--solid contact-form__submit">Submit</button>
            <p id="formError" class="contact-form__status contact-form__status--error" role="alert" hidden></p>
          </form>
          <div id="formSuccess" class="contact-form__status" role="status" tabindex="-1" hidden>
            <p>Thanks — we’ve received your message and will get back to you soon.</p>
            <button id="resetForm" type="button" class="btn contact-form__reset">Send another message</button>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('contactForm');
  const successMessage = document.getElementById('formSuccess');
  const errorMessage = document.getElementById('formError');
  const resetButton = document.getElementById('resetForm');

  if (form instanceof HTMLFormElement && successMessage && errorMessage && resetButton instanceof HTMLButtonElement) {
    const submitButton = form.querySelector('button[type="submit"]');

    const showSuccess = () => {
      form.hidden = true;
      successMessage.hidden = false;
      successMessage.focus();
    };

    const showError = (message: string) => {
      errorMessage.textContent = message;
      errorMessage.hidden = false;
      if (submitButton instanceof HTMLButtonElement) submitButton.disabled = false;
    };

    const resetForm = () => {
  const messageField = document.getElementById('message');
  if (messageField instanceof HTMLTextAreaElement) messageField.value = '';

  form.hidden = false;
  successMessage.hidden = true;
  errorMessage.hidden = true;
  if (submitButton instanceof HTMLButtonElement) submitButton.disabled = false;
  messageField?.focus();
};

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      errorMessage.hidden = true;

      if (submitButton instanceof HTMLButtonElement) submitButton.disabled = true;

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        const data = await response.json();

        if (response.ok && data.success) {
          showSuccess();
        } else {
          showError(data.message || 'Something went wrong. Please try again.');
        }
      } catch {
        showError('Something went wrong. Please try again.');
      }
    });

    resetButton.addEventListener('click', resetForm);
  }
</script>

<style>
  .contact {
    background:
      linear-gradient(oklch(0.96 0.05 85.26 / 55%), oklch(0.9 0.04 80 / 35%)),
      linear-gradient(rgb(36 27 20 / 4%), rgb(36 27 20 / 18%)),
      url('/images/striped-wood-texture.webp') center / cover;
    padding-block: var(--space-4) var(--space-5);
    box-shadow:
      inset 0 5px 12px rgb(50 28 10 / 22%),
      inset 0 -5px 12px rgb(50 28 10 / 22%);
  }
  .contact__inner {
    display: grid;
    gap: var(--space-4);
    align-items: start;
  }
  @media (min-width: 800px) {
    .contact__inner {
      grid-template-columns: 1fr 1.6fr;
      gap: var(--space-5);
    }
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .contact__title {
    font-size: clamp(2.25rem, 6vw, 3.5rem);
    text-shadow:
      -1px -1px 1px oklch(20% 0.02 63 / 0.18),
      1px  1px 1px oklch(60% 0.03 63 / 0.7);
    margin-bottom: var(--space-4);
  }

  /* Details column */
  .contact__details {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .contact__label {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    overflow-wrap: anywhere;
    text-shadow: none;
    margin-bottom: var(--space-1);
  }
  @media (max-width: 639px) {
    .contact__label {
      font-size: 1.0625rem;
    }
  }
  .contact__block p {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.6;
    color: var(--color-text-muted);
  }
  .contact__block a {
    text-decoration: none;
  }
  .contact__block a:hover {
    color: var(--color-dark-brass);
  }
  .contact__email {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  /* Form card */
  .contact-card {
    background: var(--color-bg);
    border: 6px solid #7a5330;
    border-radius: 3px;
    box-shadow: 0 4px 10px rgb(40 22 8 / 35%);
    padding: clamp(1.5rem, 4vw, 2.75rem);
  }
  .contact-card__title {
    color: var(--color-dark-brass);
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin-bottom: var(--space-3);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .contact-form[hidden] {
    display: none;
  }
  .contact-form__row {
    display: grid;
    gap: var(--space-3);
  }
  @media (min-width: 560px) {
    .contact-form__row {
      grid-template-columns: 1fr 1fr;
    }
  }
  .contact-form__field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .contact-form__field label {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: oklch(37.686% 0.12823 142.511 / 0.678);
  }
  .contact-form__field input,
  .contact-form__field textarea {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-cream);
    background: transparent;
    border: none;
    border-bottom: 1px solid oklch(35% 0.02 63 / 45%);
    padding: 6px 2px;
    border-radius: 0;
  }
  .contact-form__field textarea {
    resize: vertical;
    min-height: 5rem;
  }
  .contact-form__field input:focus,
  .contact-form__field textarea:focus {
    outline: none;
    border-bottom-color: var(--color-dark-brass);
  }
  .contact-form__submit {
    align-self: center;
  }
  .contact-form__submit:active {
    transform: translateY(2px);
    box-shadow:
      inset 0 2px 4px rgb(55 33 18 / 35%),
      0 1px 0 oklch(45% 0.1 75);
  }
  .contact-form__submit:disabled {
    cursor: wait;
    opacity: 0.65;
  }
  .contact-form__status {
    color: var(--color-dark-brass);
    font-size: 1.125rem;
    text-align: center;
    outline: none;
  }
  .contact-form__status:focus {
    outline: none;
  }
  .contact-form__status--error {
    color: var(--color-oxblood);
    font-size: 0.9375rem;
  }
  .contact-form__status p {
    margin-bottom: var(--space-3);
  }
  .contact-form__reset {
    align-self: center;
  }

  @media (max-width: 799px) {
    .contact {
      padding-block: var(--space-4);
    }
  }
</style>
